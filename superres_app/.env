# -------------------------------------------------------------------------
# superres_app/.env.example
#
# Copy this file to one of these locations (in priority order):
#   1. /Volumes/Work/Sen2/V4/.env                (project root .env)
#   2. /Volumes/Work/Sen2/V4/superres_app/.env   (app-specific .env)
#
# The app will read whichever .env is loaded by python-dotenv.
#
# You can set checkpoint paths here to tell the super-resolution
# model where to find its weights. If you don't set them, the app
# will fall back to the bundled weights under:
#   superres_app/models/edsr_base/best_model_checkpoint.pt
#   superres_app/models/edsr_base_8_block/best_model_checkpoint.pt
#
# -------------------------------------------------------------------------


############################
# RUNTIME / ENVIRONMENT MODE
############################
# ENV_MODE controls how we run inference.
# - local-mock : lightweight / CPU-friendly mode for dev
# - local      : run real model locally (CPU or GPU if available)
# - remote     : you're on a proper server / GPU box
# - colab      : running in Google Colab
#
# If unset, code may default to "local" or "local-mock".
ENV_MODE=local-mock


############################
# MODEL CHECKPOINT PATHS
############################
# These are OPTIONAL.
# If you don't set them, we use the bundled checkpoints under:
#   superres_app/models/edsr_base/best_model_checkpoint.pt
#   superres_app/models/edsr_base_8_block/best_model_checkpoint.pt
#
# If you *do* set them, they must be ABSOLUTE paths that exist
# on the machine you're running.
#
# --- Example: Mac dev box ----------------------------------
# CKPT_PATH_EDSR_16=/Volumes/Work/Sen2/V4/superres_app/models/edsr_base/best_model_checkpoint.pt
# CKPT_PATH_EDSR_8=/Volumes/Work/Sen2/V4/superres_app/models/edsr_base_8_block/best_model_checkpoint.pt
#
# --- Example: Linux GPU server -----------------------------
# CKPT_PATH_EDSR_16=/home/ubuntu/models/sr/edsr_base/best_model_checkpoint.pt
# CKPT_PATH_EDSR_8=/home/ubuntu/models/sr/edsr_base_8_block/best_model_checkpoint.pt
#
# --- Example: Windows workstation --------------------------
# CKPT_PATH_EDSR_16=C:/ml/sr/edsr_base/best_model_checkpoint.pt
# CKPT_PATH_EDSR_8=C:/ml/sr/edsr_base_8_block/best_model_checkpoint.pt
#
# (Use forward slashes on Windows or escape backslashes.)
#
#CKPT_PATH_EDSR_16=
#CKPT_PATH_EDSR_8=

DISABLE_TORCH=1